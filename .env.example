# ─────────────────────────────────────────────────────────────
# US Bank Validator by Affan — server configuration
# Copy to .env and fill in what you have. Every setting is optional:
# with nothing set, the app runs format + ABA checksum checks only and says so.
# NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────

PORT=3000

# Comma-separated list of browser origins allowed to call this API
# (needed only when the frontend is hosted elsewhere, e.g. GitHub Pages).
# Example: https://getmefreegetmefree-del.github.io
ALLOWED_ORIGINS=

RATE_LIMIT_PER_MINUTE=30
PROVIDER_TIMEOUT_MS=15000

# ── Lyons Commercial Data (same data as iBankRegistry) — recommended if you have Lyons
# Web-services credentials come from Lyons (Company ID, user name, password).
# Turns on: full institution profile (phones by department, office + mailing address,
# homepage, Lyons ID, branch count, routing numbers, Wire/RTP/FedNow) and, with
# ACCOUNT_VERIFICATION_PROVIDER=lyons, real account-status checks (AOA).
LYONS_COMPANY_ID=
LYONS_USERNAME=
LYONS_PASSWORD=
# Inquiry amount sent with AOA status checks (required by Lyons, must be ≥ 0.01; no money moves)
LYONS_AOA_AMOUNT=1.00

# ── Routing directory: option A — Federal Reserve FedACH file (authoritative for ACH)
# Put FedACHdir.txt (or FedACHdir.json) in ./data, or point to it here:
FEDACH_DIRECTORY_PATH=

# ── Routing directory: option B — Increase routing-number API
# Get a key at https://dashboard.increase.com/developers/api_keys
# Lookups are read-only. Sandbox only recognizes a few test routing numbers,
# so use "production" for real lookups.
INCREASE_API_KEY=
INCREASE_ENVIRONMENT=production

# ── Real account verification
# "none" (default), "lyons" or "socure"
ACCOUNT_VERIFICATION_PROVIDER=none

# Socure Account Intelligence (RiskOS). Requires a Socure contract.
SOCURE_API_KEY=
SOCURE_ENVIRONMENT=sandbox            # sandbox | production
SOCURE_WORKFLOW=bank_account_validation

# Socure returns an availability SCORE (0.0–1.0), not a fixed status label. The score
# bands and reason-code meanings are published in YOUR RiskOS dashboard
# (Settings → Advanced Docs → Account Intelligence Scoring). Copy them here.
# Leave these blank and the app will show the raw score as "Unable to verify"
# rather than guess.
SOCURE_OPEN_MIN_SCORE=
SOCURE_CLOSED_MAX_SCORE=
SOCURE_CLOSED_REASON_CODES=
SOCURE_INVALID_REASON_CODES=
SOCURE_NOT_FOUND_REASON_CODES=
